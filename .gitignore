# OS / editor
.DS_Store
Thumbs.db
*.swp

# graphify: version the shareable outputs (graph.json/html, GRAPH_REPORT.md),
# ignore the regenerated cache + machine-local internal state (churn on every rebuild)
graphify-out/cache/
graphify-out/.graphify_*
graphify-out/.node_index.txt

# Python cache
__pycache__/
*.pyc

# Word temp / lock files
~$*
