@startuml esp4_security
title ESP4 - Security (alarm_control_panel + door/motion)

participant "Home Assistant" as HA
participant "MQTT broker" as BROKER
participant "mqtt_wrap" as MQTT
participant "security.c" as SEC
participant "tick_task\n(FreeRTOS, high prio)" as TASK
participant "Door reed" as DOOR
participant "PIR motion" as PIR
participant "Siren GPIO" as SIREN

== Discovery (on connect) ==
MQTT -> SEC: on_connect()
SEC -> BROKER: subscribe home/security/alarm/set
SEC -> BROKER: publish alarm_control_panel + door + motion config (retain)
BROKER -> HA: entities appear (disarmed)

== Arm away ==
HA -> BROKER: home/security/alarm/set = "ARM_AWAY"
BROKER -> MQTT: MQTT_EVENT_DATA
MQTT -> SEC: on_message(...,"ARM_AWAY")
SEC -> BROKER: publish alarm/state = "arming"
note over SEC: exit delay (exit_delay_ms)

== State machine (every 100 ms) ==
loop
  TASK -> SEC: tick_task()
  SEC -> DOOR: read reed
  SEC -> PIR: read motion
  SEC -> BROKER: publish door/motion on change
  alt state ARMING and exit delay elapsed
    SEC -> BROKER: publish alarm/state = "armed_away"
  else ARMED_AWAY and (door or motion)
    SEC -> BROKER: publish alarm/state = "pending"
    note over SEC: entry delay (entry_delay_ms)
  else PENDING and entry delay elapsed
    SEC -> SIREN: gpio_set_level(on)
    SEC -> BROKER: publish alarm/state = "triggered"
  end
end

== Disarm ==
HA -> BROKER: home/security/alarm/set = "DISARM"
MQTT -> SEC: on_message(...,"DISARM")
SEC -> SIREN: gpio_set_level(off)
SEC -> BROKER: publish alarm/state = "disarmed"
@enduml
